    <script>
        function initMap() {
            var uluru = { lat: 14.234719, lng: 76.400194 };

            var map = new google.maps.Map(document.getElementById('map'), {
                zoom: 4,
                center: uluru
            });
            var marker = new google.maps.Marker({
                position: uluru,
                map: map
            });
        }

        $(document).ready(function () {
            $("#btnToggle").click(function () {
                $("#mainNavBar").removeClass("navList");
            });
        });

        $(document).ready(function () {
            $(window).scroll(function () {
                if ($(this).scrollTop() > 50) {
                    $('#back-to-top').fadeIn();
                } else {
                    $('#back-to-top').fadeOut();
                }
            });
            // scroll body to 0px on click
            $('#back-to-top').click(function () {
                $('#back-to-top').tooltip('hide');
                $('body,html').animate({
                    scrollTop: 0
                }, 800);
                return false;
            });


        });
    </script>
    <script async defer
            src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAOuZQSRNxd9S15jimvVLdl0VUIpl7LNR4&callback=initMap">
    </script>
