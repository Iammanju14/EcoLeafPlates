@model IEnumerable<EcoLeafPlates.Models.clsUserDetails>

@{
    ViewBag.Title = "DisplayUserDetails";
    Layout = "~/Views/Shared/Master.cshtml";
}


<table class="table table-responsive table-bordered">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.userId)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.name)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.phoneNo)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.address)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.mailId)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.passowrd)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.date)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.isActive)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Role)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.userId)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.name)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.phoneNo)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.address)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.mailId)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.passowrd)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.date)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.isActive)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Role)
        </td>

        <td>
            <input type="button" class="btn btn-primary bg-dark removeRad" value="Edit" onclick="location.href='@Url.Action("EditUserDetails", new { UserId = item.userId })'" />

        </td>
        <td>
            <a class="btn btn-primary bg-dark removeRad"
               href='@Url.Action("DeleteUserDetails", "User",
                new { UserId = @item.userId })' onclick="return  confirm('Are you sure you want to delete @item.name record') ">
                Delete
            </a>


        </td>
    </tr>
}

</table>
