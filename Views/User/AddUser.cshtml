@model EcoLeafPlates.Models.clsUserDetails

@{
    ViewBag.Title = "AddUser";
    Layout = "~/Views/Shared/Master.cshtml";
}


<div class="row">
    <div class="col-lg-4">

    </div>
    <div class="col-lg-4">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-horizontal">

                @Html.ValidationSummary(true, "", new { @class = "text-danger" })


                <div class="form-group">
                    @Html.LabelFor(model => model.name, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.EditorFor(model => model.name, new { htmlAttributes = new { @class = "form-control removeRad" } })
                        @Html.ValidationMessageFor(model => model.name, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.phoneNo, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.EditorFor(model => model.phoneNo, new { htmlAttributes = new { @class = "form-control removeRad" } })
                        @Html.ValidationMessageFor(model => model.phoneNo, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.address, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @*@Html.EditorFor(model => model.address, new { htmlAttributes = new { @class = "form-control removeRad" } })*@
                        @Html.TextAreaFor(model => model.address, 5, 35, new { @class = "form-control rounded-0", id = "address" })
                        @Html.ValidationMessageFor(model => model.address, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.mailId, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.EditorFor(model => model.mailId, new { htmlAttributes = new { @class = "form-control removeRad" } })
                        @Html.ValidationMessageFor(model => model.mailId, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.passowrd, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.EditorFor(model => model.passowrd, new { htmlAttributes = new { @class = "form-control removeRad" } })
                        @Html.ValidationMessageFor(model => model.passowrd, "", new { @class = "text-danger" })
                    </div>
                </div>




                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" value="Create" class="btn btn-default removeRad" onclick="return validateRegister();" />
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="col-lg-4">

    </div>
</div>

<script>
    function validateRegister() {
         debugger;
        var txtName = $("#name").val();
        var txtPhone = $("#phoneNo").val();
        var txtAdress = $("#address").val();
        var txtMail = $("#mailId").val();
        var txtPhone = $("#phoneNo").val();
        var txtPassowrd = $("#passowrd").val();


        var regex = /[!@@#$%^&*()_+\-=\[\]{};':"\\|,<>\/?]/g;
        var regexmail = /\S+@@\S+\.\S+/;





        if (txtName == '') {
            alert('Please enter Name');
            return false;
        }
        else if (regex.test(txtName)) {
            alert('Special characters are not allowed in name field');
            return false;
        }

        if (txtAdress == '') {
            alert('Please enter Name');
            return false;
        }

        debugger;
        if (txtPhone == '' || txtPhone.length < 10 || txtPhone.length > 10 || txtPhone < 0 || (txtPhone % 1 != 0)) {
            alert('Please enter Phone No with 10 digits');
            return false;
        }

        if (txtPassowrd == '' || txtPassowrd.length < 6 || txtPassowrd.length > 10) {
            alert('Please enter password of min length 6 and maxlength 10');
            return false;
        }
   

    

        if (txtMail != '') {

            if (!regexmail.test(txtMail)) {
                alert('Please enter proper Mail_Id.');
                return false;
            }
        }

    

    }

    $(document).ready(function () {

        debugger;
        if ('@ViewBag.IsRegistred' === 'True')
            swal("Good job!", "Registered Successfully", "success");

        if ('@ViewBag.IsDuplicatePhonoNo' === 'True')
            swal("Howch!", "The entered Phono No is already exist, try with other No!", "warning");

    });
</script>