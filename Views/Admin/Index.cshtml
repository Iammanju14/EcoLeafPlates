<br />

<script>
    function GenerateReport() {



            var rptType = $("input[name='ReportType']:checked").val();
            var emps = JSON.stringify({ 'rptType': rptType });


            $.ajax({
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                type: 'POST',
                url: '/Admin/Reports',
                data: emps
            });




 }

</script>

