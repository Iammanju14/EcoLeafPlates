@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/Master.cshtml";
}

<div class="row" >
    <div class="col-lg-12">
        <div id="idpoemgallery" class="carousel slide" data-ride="carousel" data-interval="5000">
            <ol class="carousel-indicators">
                <li data-target="#idpoemgallery" data-slide-to="0" class="active"></li>
                <li data-target="#idpoemgallery" data-slide-to="1"></li>
                <li data-target="#idpoemgallery" data-slide-to="2"></li>
                <li data-target="#idpoemgallery" data-slide-to="3"></li>
            </ol>
            <div class="carousel-inner">
                <div class="item active">

                    <img src="~/Content/Images/HomeCarousel/1.jpg" class="img-responsive" />
                </div>

                <div class="item">
                    <img src="~/Content/Images/HomeCarousel/2.jpg" class="img-responsive" />
                </div>

                <div class="item">
                    <img src="~/Content/Images/HomeCarousel/4.jpg" class="img-responsive" />
                </div>
                <div class="item">

                    <img src="~/Content/Images/HomeCarousel/5.jpg" class="img-responsive" />
                </div>
             

            </div>
            <a href="#idpoemgallery" class="carousel-control left" data-slide="prev">
                <span class="glyphicon glyphicon-chevron-left"></span>
            </a>
            <a href="#idpoemgallery" class="carousel-control right" data-slide="next">
                <span class="glyphicon glyphicon-chevron-right"></span>
            </a>
        </div>
    </div>
</div>



